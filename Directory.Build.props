<Project>
  <!--
    多目录结构公共属性：
      src/main/dotnet/<module>   生产代码
      src/test/dotnet/<module>   测试 / 离屏渲染校验
    TargetFramework 可由命令行覆盖：dotnet build -p:TargetFramework=net10.0
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == ''">
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AvaloniaVersion>11.3.9</AvaloniaVersion>
    <MvvmVersion>8.2.2</MvvmVersion>
    <Version>1.0.0</Version>
    <Company>NeoRF</Company>
    <Product>Earth Model Studio</Product>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
  </PropertyGroup>
</Project>
