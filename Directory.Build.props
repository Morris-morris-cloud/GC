<Project>
  <!--
    多目录结构公共属性：
      GC-BOOT                    启动入口
      GC/src/                    启动器核心代码
      GC/src/test/dotnet/<module> 测试 / 离屏渲染校验
    TargetFramework 可由命令行覆盖：dotnet build -p:TargetFramework=net10.0
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == ''">
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <MvvmVersion>8.2.2</MvvmVersion>
    <!-- 模型窗口仍由 Avalonia 承载（模型契约返回 Avalonia Control），
         界面本身是 Flutter。Avalonia.BuildServices 的遥测会向用户目录写日志，
         在只读目录 / CI 里会直接让编译失败，build.sh / build.ps1 已默认关闭。 -->
    <AvaloniaVersion>11.3.9</AvaloniaVersion>
    <Version>1.1.2</Version>
    <Company>Morris</Company>
    <Product>GC</Product>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
  </PropertyGroup>
</Project>
