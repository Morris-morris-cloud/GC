<Project>
  <!--
    多目录结构公共属性：
      GC-BOOT                    启动入口
      GC/src/                    启动器核心代码
      GC/src/test/dotnet/<module> 测试 / 离屏渲染校验
    TargetFramework 可由命令行覆盖：dotnet build -p:TargetFramework=net10.0
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == ''">
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!--
      Avalonia.BuildServices 的遥测任务会向用户目录写 buildtasks.log。
      在只读用户目录 / CI / 沙箱里该写入抛 UnauthorizedAccessException(MSB4018)，
      直接让整个解决方案编译失败（实测）。官方开关是环境变量
      AVALONIA_TELEMETRY_OPTOUT=1（MSBuild 属性对 11.3.2 无效），
      build.sh / build.ps1 已默认导出；IDE 直接编译时无需此变量。
    -->
    <AvaloniaVersion>11.3.9</AvaloniaVersion>
    <MvvmVersion>8.2.2</MvvmVersion>
    <Version>1.0.10</Version>
    <Company>Morris</Company>
    <Product>GC</Product>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
  </PropertyGroup>
</Project>
