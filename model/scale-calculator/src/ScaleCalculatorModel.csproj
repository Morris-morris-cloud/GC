<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>NeoRF.ScaleCalculator</RootNamespace>
    <AssemblyName>ScaleCalculatorModel</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- 本模型不复用 _engine 的球面渲染，只用 Avalonia 基础控件 + 一个自绘标尺 -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\_sdk\GC.ModelSdk\GC.ModelSdk.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
