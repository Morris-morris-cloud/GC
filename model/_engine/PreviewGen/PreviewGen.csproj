<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>NeoRF.EarthModels</RootNamespace>
    <AssemblyName>EarthModelPreview</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- 直接编译共享引擎源码：封面必须由模型自己的渲染器画 -->
    <Compile Include="../src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <!-- 通用封面路径会渲染模型自带的 UserControl，headless 下需要主题样式才会出内容 -->
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\_sdk\GC.ModelSdk\GC.ModelSdk.csproj" />
  </ItemGroup>

</Project>
