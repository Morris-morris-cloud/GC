<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>NeoRF.EarthModels</RootNamespace>
    <AssemblyName>EarthRevolutionModel</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- 共享引擎源码就在 model/_engine 里（模型目录内），本模型直接编译进去 -->
  <ItemGroup>
    <Compile Include="../../_engine/src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\_sdk\GC.ModelSdk\GC.ModelSdk.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
