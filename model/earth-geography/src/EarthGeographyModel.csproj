<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>NeoRF.EarthModels</RootNamespace>
    <AssemblyName>EarthGeographyModel</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- 共享引擎源码（模型目录内），只编译需要的部分 -->
  <ItemGroup>
    <Compile Include="../../_engine/src/ModelJson.cs" />
    <Compile Include="../../_engine/src/Geometry.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\_sdk\EarthModelStudio.ModelSdk\EarthModelStudio.ModelSdk.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
