<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    GC-UI 后端：把原来「启动器 = UI + 服务」的一体式结构拆成
      · 后端（本工程）：模型扫描 / 下载 / 更新 / 设置 / 模型窗口宿主，只暴露本地 HTTP API
      · 前端（GC-UI/frontend，Flutter）：只做界面，通过 HTTP 调后端

    模型渲染也已并入 Flutter（lib/models/）：模型不再返回 Avalonia Control，
    后端只剩纯 HTTP API，不再依赖任何 UI 框架。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>GC.UI.Server</RootNamespace>
    <AssemblyName>GC.UI.Server</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 后端是本地伴随进程，不需要浏览器启动配置 / 静态文件 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\GC\src\GC.Core.csproj" />
    <ProjectReference Include="..\..\..\GC-DOWNLOAD\GC-DOWNLOAD.csproj" />
  </ItemGroup>

</Project>
