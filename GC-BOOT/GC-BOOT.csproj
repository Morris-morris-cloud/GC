<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>GC.Boot</RootNamespace>
    <AssemblyName>GC</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 应用图标（Windows exe / 任务栏） -->
    <ApplicationIcon>..\GC\src\Assets\icon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 后端以库的方式编进启动器：发布包只需要一个 exe，不用再带一份运行时 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GC\src\GC.Core.csproj" />
    <ProjectReference Include="..\GC-DOWNLOAD\GC-DOWNLOAD.csproj" />
    <ProjectReference Include="..\GC-UI\backend\GC.UI.Server\GC.UI.Server.csproj" />
  </ItemGroup>

</Project>
