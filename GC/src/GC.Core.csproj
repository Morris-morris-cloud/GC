<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>GC</RootNamespace>
    <AssemblyName>GC.Core</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- 界面与模型渲染都已迁到 Flutter，这里只剩纯服务代码：
         不再引用 Avalonia / MVVM / GC.ModelSdk -->
    <Compile Remove="test\**\*.cs" />
    <!-- 多语言表原先通过 Avalonia 的 avares:// 读取，改为嵌入资源 -->
    <EmbeddedResource Include="Assets\i18n\*.json"
                      LogicalName="GC.Core.Assets.i18n.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(MvvmVersion)" />
  </ItemGroup>

</Project>
