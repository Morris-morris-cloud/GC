<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EarthModelStudio.Services"
             x:Class="EarthModelStudio.Views.DownloadView">

  <Grid ColumnDefinitions="316,*" Margin="24,22,24,24">

    <!-- 模型源 -->
    <Border Grid.Column="0" Classes="card" Padding="18" Margin="0,0,16,0">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <TextBlock Classes="h2" Text="{loc:Loc dl.sources}" />

        <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="8">
          <TextBox Text="{Binding ImportUrl}" Watermark="{loc:Loc dl.importPlaceholder}" />
          <Button Classes="primary" Content="{loc:Loc dl.import}"
                  Command="{Binding ImportCommand}" HorizontalAlignment="Stretch" />
        </StackPanel>

        <TextBlock Grid.Row="2" Classes="faint" Text="{loc:Loc dl.hint}"
                   TextWrapping="Wrap" Margin="0,9,0,12" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
          <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                   Background="Transparent" BorderThickness="0" Padding="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding HostText}" Classes="faint" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ghost small" Content="✕"
                          Command="{Binding RemoveCommand}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>

        <Border Grid.Row="4" Classes="panel" Padding="12,9" Margin="0,10,0,0">
          <StackPanel Spacing="3">
            <TextBlock Classes="eyebrow" Text="{loc:Loc dl.available}" />
            <TextBlock Classes="faint" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

      </Grid>
    </Border>

    <!-- 可用模型 + 后台任务 -->
    <Border Grid.Column="1" Classes="card" Padding="20">
      <Grid RowDefinitions="Auto,*,Auto">

        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel>
            <TextBlock Classes="h2" Text="{loc:Loc dl.available}" />
            <TextBlock Classes="muted" Text="{Binding StatusMessage}" Margin="0,3,0,0" />
          </StackPanel>
          <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="90" Height="4"
                       IsVisible="{Binding IsBusy}" VerticalAlignment="Center" Margin="12,0" />
          <Button Grid.Column="2" Classes="small" Content="{loc:Loc dl.refresh}"
                  Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Models}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Height="{Binding RowHeight}" Opacity="{Binding RowOpacity}"
                        ClipToBounds="True" Margin="0,0,0,10">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Height" Duration="0:0:0.24" Easing="CubicEaseOut" />
                      <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                    </Transitions>
                  </Border.Transitions>

                  <Border Classes="panel" Padding="14,11">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                          <Border Classes="tag" VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionText}" Classes="faint" />
                          </Border>
                          <TextBlock Text="{Binding SizeText}" Classes="faint" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Classes="muted"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                        <TextBlock Text="{Binding TagsText}" Classes="faint" IsVisible="{Binding HasTags}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="primary small" Content="{Binding ButtonText}"
                              Command="{Binding DownloadCommand}" CommandParameter="{Binding}"
                              VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                  </Border>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- 后台任务（下载时折叠到这里） -->
        <Border Grid.Row="2" Classes="panel" Margin="0,12,0,0" Padding="6" IsVisible="{Binding HasJobs}">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <Button Classes="ghost" Content="{Binding JobSummary}" Command="{Binding ToggleBackgroundCommand}"
                      HorizontalContentAlignment="Left" FontSize="12" FontWeight="SemiBold" Padding="10,7" />
              <Button Grid.Column="1" Classes="ghost small" Content="{loc:Loc dl.clearDone}"
                      Command="{Binding ClearFinishedCommand}" VerticalAlignment="Center" Margin="0,0,6,0" />
            </Grid>

            <ScrollViewer MaxHeight="200" IsVisible="{Binding IsBackgroundOpen}">
              <ItemsControl ItemsSource="{Binding Jobs}" Margin="6,0,6,6">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Surface}" CornerRadius="9" Padding="10,8" Margin="0,4,0,0">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="faint" />
                          </Grid>
                          <ProgressBar Value="{Binding Progress}" Maximum="1" IsVisible="{Binding IsActive}" />
                          <TextBlock Text="{Binding DetailText}" Classes="faint" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                    VerticalAlignment="Center" Margin="10,0,0,0">
                          <Button Classes="ghost small" Content="{loc:Loc dl.cancel}"
                                  IsVisible="{Binding IsActive}"
                                  Command="{Binding $parent[ItemsControl].DataContext.CancelJobCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="ghost small" Content="{loc:Loc dl.retry}"
                                  IsVisible="{Binding CanRetry}"
                                  Command="{Binding $parent[ItemsControl].DataContext.RetryJobCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="ghost small" Content="{loc:Loc dl.removeTask}"
                                  Command="{Binding $parent[ItemsControl].DataContext.RemoveJobCommand}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

      </Grid>
    </Border>
  </Grid>
</UserControl>
